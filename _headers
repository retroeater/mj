/img/*
  Cache-Control: public, max-age=31536000, immutable

# ファイル名にハッシュを持たないため、immutableのまま差し替えると
# 既存訪問者には最大1年古いアイコンが残る(assets/vendorの30日キャッシュと
# 同じ落とし穴、#174)。1日に緩和する
/favicon.ico
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/assets/vendor/*
  Cache-Control: public, max-age=2592000

# houou/ouka_leagues_data.jsonはGitHub Actionsが同じURLのまま再生成するため
# ハッシュ付きファイル名前提のimmutableは使えない(#154)。「結果発表を見に
# 来る→まだ更新されていない→後日更新される→再訪問時にキャッシュが残っていて
# 見えない」を避けたいため、1日のmax-ageにして連続訪問のみ救う(選手を
# 切り替えるたびの再取得を防ぐという当初の目的は同一訪問中のセッションで
# 足りるため1日で十分)。期限切れ後もCloudflareが自動付与するETagで条件付き
# GET(304)による再検証が働くため、内容が変わっていなければ104KB/12KBの
# 再ダウンロードは発生しない
/houou_leagues_data.json
  Cache-Control: public, max-age=86400

/ouka_leagues_data.json
  Cache-Control: public, max-age=86400

# workers.dev のURLは本番(ryoei.pro)と同一内容を返すため、重複コンテンツとして
# 評価が分散しないよう検索エンジンにインデックスさせない(#114)。
# ホスト指定のルールなので ryoei.pro 側にはこのヘッダは付かない。
# このパターンは本番ルート(mj.<サブドメイン>.workers.dev)と
# プレビューURL(<prefix>-mj.<サブドメイン>.workers.dev)の両方に一致する
# (どちらも workers.dev の前が2ラベルのため)。
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex

# .txtにはCloudflare側でcharsetが付かず、日本語環境のブラウザが
# Shift_JISとして解釈して文字化けする(#161)。UTF-8を明示する。
/llms.txt
  Content-Type: text/plain; charset=utf-8

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains